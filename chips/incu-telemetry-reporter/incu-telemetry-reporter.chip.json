{
  "name": "IncuNest Telemetry Reporter",
  "author": "IncuNest",
  "pins": ["TX", "VCC", "GND"],
  "controls": [
    { "id": "chamberTemp", "label": "Chamber Temp (°C)", "type": "range", "min": 20, "max": 42, "step": 0.1 },
    { "id": "skinTemp",    "label": "Skin Temp (°C)",    "type": "range", "min": 28, "max": 40, "step": 0.1 },
    { "id": "humidity",    "label": "Humidity (%)",       "type": "range", "min": 10, "max": 100, "step": 1 },
    { "id": "fanRpm",      "label": "Fan RPM",            "type": "range", "min": 0, "max": 4000, "step": 50 },
    { "id": "heaterDuty",  "label": "Heater Duty (%)",    "type": "range", "min": 0, "max": 100, "step": 1 },
    { "id": "doorOpen",    "label": "Door Open",          "type": "range", "min": 0, "max": 1, "step": 1 },
    { "id": "alarm",       "label": "Alarm Code",         "type": "range", "min": 0, "max": 5, "step": 1 }
  ]
}
